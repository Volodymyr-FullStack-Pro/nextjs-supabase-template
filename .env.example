# Скопировать в .env.local (он в .gitignore). Значения — из Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Прямое подключение для Drizzle (миграции, серверные задачи). Локально — из `supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
