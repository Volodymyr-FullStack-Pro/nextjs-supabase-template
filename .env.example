# Скопировать в .env.local (он в .gitignore). Значения — из Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Прямое подключение для Drizzle (серверные задачи). Локально — из `supabase status`.
# На Vercel — пул Supavisor в режиме transaction, порт 6543 (Supabase → Connect → Transaction pooler):
# postgresql://postgres.<project-ref>:<пароль базы>@<pooler-host>:6543/postgres
# Клиент уже настроен под него: prepare: false, одно соединение на функцию, SSL вне локальной машины.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Второй фактор (TOTP) обязателен для всех: true — без него вход ведёт на /mfa/setup. Финансовые проекты — true.
AUTH_REQUIRE_MFA=false
# Секрет плановых задач (/api/cron/*): Vercel Cron передаёт его в заголовке Authorization. Задать в Vercel → Settings → Environment Variables.
CRON_SECRET=
# Sentry — ошибки сервера. Пусто — Sentry выключен (локально, CI). Организация Sentry — в регионе EU (docs/release.md).
SENTRY_DSN=
# Окружение в Sentry: на Vercel production и preview определяются сами, для staging задать SENTRY_ENVIRONMENT=staging.
# SENTRY_ENVIRONMENT=
# Source maps в Sentry при сборке на Vercel; без этих трёх сборка идёт, но стек ошибок — по сжатому коду.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Тестовый пользователь для проверки экранов за входом (Playwright MCP, e2e) — в отдельном файле .env.test.local:
# его Claude может читать, а .env.local с ключами — нет. Пользователь создаётся в Studio → Authentication.
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
