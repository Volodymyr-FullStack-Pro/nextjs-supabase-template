{
  "extraKnownMarketplaces": {
    "claude-kit": {
      "source": { "source": "github", "repo": "Volodymyr-FullStack-Pro/claude-kit" }
    }
  },
  "enabledPlugins": {
    "dev-kit@claude-kit": true
  },
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:e2e:*)",
      "Bash(npm run req:check:*)",
      "Bash(supabase test db:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push origin --delete:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development*)",
      "Read(./.env.staging*)",
      "Read(./.env.production*)",
      "mcp__clickup__clickup_delete_task",
      "mcp__clickup__clickup_delete_comment",
      "mcp__clickup__clickup_delete_chat_message"
    ]
  }
}
