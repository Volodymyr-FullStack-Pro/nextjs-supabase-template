{
  "extraKnownMarketplaces": {
    "claude-kit": {
      "source": { "source": "github", "repo": "Volodymyr-FullStack-Pro/claude-kit" }
    }
  },
  "enabledPlugins": {
    "dev-kit@claude-kit": true
  },
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run req:check:*)",
      "Bash(npm run licenses:*)",
      "Bash(npm run knip:*)",
      "Bash(npm run jscpd:*)",
      "Bash(npm run format:check:*)",
      "Bash(npm run budget:*)",
      "Bash(npm run db:types:*)",
      "Bash(npm run db:check-migrations:*)",
      "Bash(npm run totp:*)",
      "Bash(supabase test db:*)",
      "Bash(supabase db advisors:*)",
      "Bash(supabase db lint:*)",
      "Bash(supabase status:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git push origin --delete:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development*)",
      "Read(./.env.staging*)",
      "Read(./.env.production*)",
      "mcp__clickup__clickup_delete_task",
      "mcp__clickup__clickup_delete_comment",
      "mcp__clickup__clickup_delete_chat_message"
    ]
  }
}
