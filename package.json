{
  "name": "nextjs-supabase-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "budget": "node scripts/bundle-budget.mjs",
    "start": "next start",
    "check": "npm run lint && npm run lint:rules && tsc --noEmit && npm run req:check && npm run docs:check && npm run comments:check && npm run licenses && npm run test:coverage && npm run knip && npm run jscpd && npm run format:check && npm run build && npm run budget",
    "gate": "sh -c '[ \"$#\" -eq 0 ] || { echo \"usage: npm run gate takes no arguments; a subset of e2e is npm run gate:quick -- <files>\" >&2; exit 2; }; node scripts/gate-stamp.mjs start && node scripts/with-local-supabase.mjs npm run check && npm run gate:db && E2E_PREBUILT=1 npm run test:e2e:db && node scripts/gate-stamp.mjs done full' gate",
    "gate:db": "supabase db advisors --fail-on warn && supabase db lint --fail-on warning && supabase test db && npm run db:check-migrations",
    "gate:quick": "sh -c '[ \"$#\" -gt 0 ] || { echo \"usage: npm run gate:quick -- <e2e files>; the whole suite is npm run gate\" >&2; exit 2; }; node scripts/gate-stamp.mjs start && node scripts/with-local-supabase.mjs npm run check && npm run gate:db && E2E_PREBUILT=1 npm run test:e2e:db -- \"$@\" && node scripts/gate-stamp.mjs done reduced' gate:quick",
    "lint": "next typegen && eslint . --max-warnings=0",
    "lint:rules": "node tests/lint-rules/check.mjs",
    "lint:fix": "next typegen && eslint . --fix --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "jscpd": "jscpd -c .jscpd.json src",
    "req:check": "node scripts/requirements-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "comments:check": "node scripts/check-comment-language.mjs",
    "ci:usage": "node scripts/ci-usage.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:types": "node scripts/with-local-supabase.mjs node scripts/db-types.mjs && prettier --write src/shared/infrastructure/supabase/types.ts",
    "test:e2e": "playwright test",
    "test:e2e:db": "node scripts/with-local-supabase.mjs playwright test",
    "perf": "node scripts/with-local-supabase.mjs playwright test --config playwright.perf.config.ts",
    "audit:prod": "node scripts/audit.mjs",
    "new:module": "node scripts/new-module.mjs",
    "generator:check": "node scripts/generator-check.mjs",
    "prepare": "simple-git-hooks || true",
    "db:check-migrations": "node scripts/check-migrations.mjs",
    "db:new": "node scripts/db-new.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "seed:test-user": "node scripts/with-local-supabase.mjs node scripts/seed-test-user.mjs",
    "totp": "node scripts/totp-code.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.9",
    "@next-safe-action/adapter-react-hook-form": "^2.1.0",
    "@sentry/nextjs": "^11.17.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/strictest": "^2.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "otplib": "^13.6.0",
    "postgres": "^4.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "simple-git-hooks": "^2.14.0",
    "squawk-cli": "2.74.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch@^10.0.0": "^11.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{md,json,css,yml,yaml}": [
      "prettier --write"
    ],
    "package-lock.json": "node scripts/check-lock.mjs"
  },
  "allowScripts": {
    "fsevents": false,
    "simple-git-hooks": false
  }
}
