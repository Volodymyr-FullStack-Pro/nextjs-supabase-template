{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,error,global-error,not-found,loading,route,template}.{ts,tsx}",
    "src/shared/ui/**/*.tsx",
    "src/shared/infrastructure/supabase/admin.ts",
    "scripts/{db-types,seed-test-user}.mjs",
    "tests/**/*.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
  "ignoreDependencies": ["tailwindcss", "shadcn", "tw-animate-css"],
  "ignoreBinaries": ["supabase"],
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "src/shared/infrastructure/supabase/types.ts",
    "tests/lint-rules/fixtures/src/modules/sample/infrastructure/direct-database.ts"
  ]
}
