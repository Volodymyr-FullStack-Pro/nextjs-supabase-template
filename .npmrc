# Политика установки зависимостей: npm 11.19 и новее (Node 24) — локально, в CI и на Vercel.

# Install-скрипты зависимостей. Решение по каждому пакету — поле allowScripts в package.json
# (npm install-scripts ls | approve <пакет> | deny <пакет>). Пакет со скриптом, по которому решения нет,
# останавливает установку (без этой строки npm только предупреждает и скрипт выполняет).
strict-allow-scripts=true

# Свежие версии. Версия моложе трёх дней не попадает в lock-файл при npm install и npm update —
# тот же срок, что cooldown в .github/dependabot.yml. Версии, уже записанные в lock-файл, ставятся как есть.
# Осознанный обход (срочное исправление уязвимости): npm install <пакет>@<версия> --min-release-age=0.
min-release-age=3
